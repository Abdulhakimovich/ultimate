# Supabase Configuration
# Required: All users must authenticate and all data is isolated per-user via RLS.
# Both variables are REQUIRED.
# In Vercel (or any deployment platform), they must be set for Production AND Preview environments,
# and must be set BEFORE the build step because NEXT_PUBLIC_* variables are inlined at build time.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
